#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer indices follow declaration order in keymap */
#define BASE   0
#define MACOS  1
#define GAME   2
#define LOWER  3
#define RAISE  4
#define ADJUST 5

/ {
    behaviors {
        base_switch: base_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&to BASE>, <&to MACOS>, <&to GAME>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mac_lower {
            if-layers = <1 4>;
            then-layer = <7>;
        };

        mac_raise {
            if-layers = <1 4>;
            then-layer = <7>;
        };
    };

    macros {
        auto_tilde: auto_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp SPACE>;
            label = "Types a tilde (win/linux)";
        };

        delete_and_spacebar: delete_and_spacebar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE &kp SPACE>;
            label = "Removes line breaks";
        };

        mac_tilde: mac_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp SPACE>;

            label = "Types a tilde (macOS)";
        };

        mac_screenshot_area: mac_screenshot_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp N4>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            label = "Screenshot selection (Cmd+Shift+4)";
        };

        mac_screenshot_full: mac_screenshot_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings =
                <&macro_press>,
                <&kp LGUI &kp LSHFT>,
                <&macro_tap>,
                <&kp N3>,
                <&macro_release>,
                <&kp LSHFT &kp LGUI>;

            label = "Screenshot full (Cmd+Shift+3)";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3        &kp N4                 &kp N5                                                     &kp N6  &kp N7     &kp N8      &kp N9     &kp N0      &none
&kp TAB         &kp Q   &kp W   &kp E         &kp R                  &kp T                                                      &kp Y   &kp U      &kp I       &kp O      &kp P       &kp LEFT_BRACKET
&kp BACKSPACE   &kp A   &kp S   &kp D         &kp F                  &kp G                                                      &kp H   &kp J      &kp K       &kp L      &kp SEMI    &kp APOS
&kp LEFT_SHIFT  &mo 4   &kp Z   &kp X         &kp C                  &kp V             &kp C_PLAY_PAUSE    &kp INTERNATIONAL_1  &kp B   &kp N      &kp M       &kp COMMA  &kp PERIOD  &kp FSLH
                                &kp LEFT_GUI  &mt LEFT_ALT LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_SHIFT      &kp SPACE            &mo 4   &kp ENTER  &kp DELETE
            >;
        };

        MACOS {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3            &kp N4        &kp N5                                                 &kp N6  &kp N7     &kp N8      &kp N9     &kp N0      &none
&kp TAB         &kp Q   &kp W   &kp E             &kp R         &kp T                                                  &kp Y   &kp U      &kp I       &kp O      &kp P       &kp LEFT_BRACKET
&kp CAPSLOCK    &kp A   &kp S   &kp D             &kp F         &kp G                                                  &kp H   &kp J      &kp K       &kp L      &kp SEMI    &kp APOS
&kp LEFT_SHIFT  &mo 4   &kp Z   &kp X             &kp C         &kp V         &kp C_PLAY_PAUSE    &kp INTERNATIONAL_1  &kp B   &kp N      &kp M       &kp COMMA  &kp PERIOD  &kp FSLH
                                &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LEFT_SHIFT      &kp SPACE            &mo 4   &kp ENTER  &kp DELETE
            >;
        };

        GAME {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                             &kp N6  &kp N7   &kp N8   &kp N9     &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                              &kp Y   &kp U    &kp I    &kp O      &kp P     &kp LBKT
&kp BSPC   &kp A   &kp S   &kp D     &kp F     &kp G                              &kp H   &kp J    &kp K    &kp L      &kp SEMI  &kp APOS
&kp LSHFT  &mo 4   &kp Z   &kp X     &kp C     &kp V      &kp C_PP     &kp INT1   &kp B   &kp N    &kp M    &kp COMMA  &kp DOT   &kp FSLH
                           &kp LGUI  &kp LALT  &kp LCTRL  &kp SPACE    &kp SPACE  &mo 4   &kp RET  &kp DEL
            >;
        };

        LOWER {
            bindings = <
&trans  &trans           &trans  &trans  &trans  &trans                                                        &trans  &trans       &trans          &trans     &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans                                                        &trans  &auto_tilde  &kp PIPE        &kp PLUS   &trans  &trans
&trans  &kp PRINTSCREEN  &trans  &trans  &trans  &delete_and_spacebar                                          &trans  &kp EQUAL    &kp UNDERSCORE  &kp MINUS  &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans                &bt BT_CLR_ALL    &kp NON_US_BACKSLASH  &trans  &trans       &trans          &kp LT     &kp GT  &trans
                                 &trans  &trans  &kp ESC               &kp SPACE         &trans                &mo 5   &trans       &trans
            >;
        };

        RAISE {
            bindings = <
&trans  &trans  &trans  &trans             &trans             &trans                    &trans  &kp C_PREV  &kp C_PP      &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP
&trans  &trans  &trans  &kp RIGHT_BRACE    &kp LS(BACKSLASH)  &trans                    &trans  &kp HOME    &kp UP_ARROW  &kp END     &trans        &trans
&trans  &trans  &trans  &kp LS(LPAR)       &kp LS(RPAR)       &trans                    &trans  &kp LEFT    &kp DOWN      &kp RIGHT   &trans        &trans
&trans  &mo 5   &trans  &kp RIGHT_BRACKET  &kp BACKSLASH      &trans  &trans    &trans  &trans  &trans      &trans        &trans      &trans        &trans
                        &trans             &trans             &trans  &trans    &trans  &trans  &trans      &trans
            >;
        };

        ADJUST {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                        &kp F7  &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&out OUT_USB  &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR                    &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans   &trans
&trans        &trans        &trans        &trans        &trans        &base_switch                  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans   &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans    &trans  &trans  &msc SCRL_UP    &msc SCRL_DOWN  &trans           &trans   &trans
                                          &trans        &trans        &trans      &trans    &trans  &trans  &trans          &trans
            >;
        };
    };
};
