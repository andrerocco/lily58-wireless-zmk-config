#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        auto_tilde: auto_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp SPACE>;
            label = "Types a tilde";
        };

        delete_and_spacebar: delete_and_spacebar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE &kp SPACE>;
            label = "Removes line breaks";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp GRAVE       &kp N1  &kp N2  &kp N3        &kp N4                 &kp N5                                                     &kp N6  &kp N7     &kp N8  &kp N9     &kp N0      &kp MINUS
&kp TAB         &kp Q   &kp W   &kp E         &kp R                  &kp T                                                      &kp Y   &kp U      &kp I   &kp O      &kp P       &kp LEFT_BRACKET
&kp BACKSPACE   &kp A   &kp S   &kp D         &kp F                  &kp G                                                      &kp H   &kp J      &kp K   &kp L      &kp SEMI    &kp APOS
&kp LEFT_SHIFT  &mo 1   &kp Z   &kp X         &kp C                  &kp V             &kp C_PLAY_PAUSE    &kp INTERNATIONAL_1  &kp B   &kp N      &kp M   &kp COMMA  &kp PERIOD  &kp FSLH
                                &kp LEFT_GUI  &mt LEFT_ALT LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_SHIFT      &kp SPACE            &mo 2   &kp ENTER  &trans
            >;
        };

        LOWER {
            bindings = <
&trans  &trans           &trans  &trans  &trans  &trans                                     &trans  &trans           &trans         &trans           &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans                                     &trans  &kp RIGHT_BRACE  &kp BACKSLASH  &kp EXCLAMATION  &trans  &trans
&trans  &kp PRINTSCREEN  &trans  &trans  &trans  &delete_and_spacebar                       &trans  &kp EQUAL        &kp PLUS       &kp MINUS        &trans  &trans
&trans  &trans           &trans  &trans  &trans  &trans                &trans       &trans  &trans  &trans           &trans         &trans           &trans  &trans
                                 &trans  &trans  &kp ESC               &kp SPACE    &trans  &mo 3   &trans           &trans
            >;
        };

        RAISE {
            bindings = <
&trans  &trans          &trans         &trans        &trans          &trans                    &trans  &kp C_PREV  &kp C_PP      &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP
&trans  &trans          &kp SQT        &kp LS(LBRC)  &kp LS(RBRC)    &trans                    &trans  &kp HOME    &kp UP_ARROW  &kp END     &trans        &trans
&trans  &kp UNDERSCORE  &kp EQUAL      &kp LS(LPAR)  &kp LS(RPAR)    &trans                    &trans  &kp LEFT    &kp DOWN      &kp RIGHT   &trans        &trans
&trans  &mo 3           &kp BACKSLASH  &auto_tilde   &kp APOSTROPHE  &trans  &trans    &trans  &trans  &trans      &trans        &trans      &trans        &trans
                                       &trans        &trans          &trans  &trans    &trans  &trans  &trans      &trans
            >;
        };

        ADJUST {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                        &kp F7  &kp F8          &kp F9          &kp F10          &kp F11  &kp F12
&out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR                    &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans   &trans
&trans        &trans        &trans        &trans        &trans        &trans                        &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans   &trans
&trans        &trans        &trans        &trans        &trans        &trans      &trans    &trans  &trans  &msc SCRL_UP    &msc SCRL_DOWN  &trans           &trans   &trans
                                          &trans        &trans        &trans      &trans    &trans  &trans  &trans          &trans
            >;
        };
    };
};
